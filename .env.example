# Same-origin path; Vite proxies this to the Readie hackathon API during development.
VITE_API_BASE_URL=/api

# Copy the request credentials into your local .env file; do not commit them.
VITE_API_MY_AUTHORIZATIONX=replace-with-MyAuthorizationx-value
VITE_API_AUTHORIZATION=Basic replace-with-Base64-credential

# Set to true only to use the offline fixtures instead of the live API.
VITE_USE_MOCK_API=false
